tamber duolab

// The Arrangement screen's pane tints: UIKit's system blue and orange at the
// reference app's opacities (12% under the pane, 30% and 16% on alternate rows)
theme
  pane.primary = light-dark(rgb(0 122 255 / 0.12), rgb(10 132 255 / 0.12))
  pane.primary.stripe = light-dark(rgb(0 122 255 / 0.30), rgb(10 132 255 / 0.30))
  pane.primary.band = light-dark(rgb(0 122 255 / 0.16), rgb(10 132 255 / 0.16))
  pane.secondary = light-dark(rgb(255 149 0 / 0.12), rgb(255 159 10 / 0.12))
  pane.secondary.stripe = light-dark(rgb(255 149 0 / 0.30), rgb(255 159 10 / 0.30))
  pane.secondary.band = light-dark(rgb(255 149 0 / 0.16), rgb(255 159 10 / 0.16))

icons
  icon.keyboard = icon(sf "keyboard", svg "icons/keyboard.svg")
  icon.split = icon(sf "rectangle.split.2x1", svg "icons/split.svg")
  icon.next = icon(sf "arrow.right", svg "icons/next.svg")
